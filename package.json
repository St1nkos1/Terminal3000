{
  "name": "terminal3000",
  "productName": "Terminal3000",
  "version": "0.1.0",
  "description": "Терминал для Windows, в котором удобно держать несколько сессий Claude Code",
  "author": "st1nkos",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "test": "vitest run",
    "test:e2e": "electron-vite build && playwright test",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "check:pty": "node scripts/check-pty.cjs",
    "icon": "node scripts/make-icon.mjs",
    "dist": "electron-vite build && electron-builder --win"
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true,
    "node-pty": false,
    "electron-winstaller": false
  },
  "dependencies": {
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  }
}
